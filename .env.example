# obsidian-second-brain - research toolkit credentials
# Copy this file to ~/.config/obsidian-second-brain/.env and fill in the values.
# That path is Mac-local - never committed, never synced. Set permissions 600.

# ─── Vault location (required) ──────────────────────────────
# Absolute path to your Obsidian vault root. Research notes save here.
OBSIDIAN_VAULT_PATH=

# ─── xAI Grok ───────────────────────────────────────────────
# Powers /x-read and /x-pulse (live X reading + trend analysis)
# Get key: https://console.x.ai
XAI_API_KEY=

# ─── Perplexity ─────────────────────────────────────────────
# Powers /research and /research-deep (web research with citations)
# Get key: https://perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ─── Tavily (optional) ──────────────────────────────────────
# Extra web-search source for /research free mode - joins the key-less pool
# when set, skipped silently when empty. Free tier available.
# Get key: https://app.tavily.com
TAVILY_API_KEY=

# ─── Brave Search (optional) ────────────────────────────────
# Extra web-search source for /research free mode - joins the key-less pool
# when set, skipped silently when empty. Requires a card: plans start at
# $5/1,000 requests with $5 free credits monthly (as of 2026-07).
# Get key: https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# ─── Keenable (optional) ────────────────────────────────────
# Extra web-search source for /research free mode, off by default. Needs no
# key: set RESEARCH_KEENABLE=1 to add it to the pool; empty means it never runs.
# Run by Keenable; your query text is sent to Keenable. Anonymous limit 1,000
# requests an hour, 10 a second per IP (as of 2026-11). An optional
# KEENABLE_API_KEY only lifts that limit and does not switch the source on.
# Docs: https://docs.keenable.ai
RESEARCH_KEENABLE=
KEENABLE_API_KEY=

# ─── Google Gemini ──────────────────────────────────────────
# Powers /notebooklm (vault-grounded synthesis via Gemini File Search).
# Get key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── YouTube Data API v3 (optional) ─────────────────────────
# Powers /youtube metadata + comments. Transcripts work without this key.
# Get key: https://console.cloud.google.com → enable YouTube Data API v3
YOUTUBE_API_KEY=

# Preferred transcript languages for /youtube, comma-separated, tried in
# order (e.g. "ja,en"). If none match, /youtube falls back to whatever
# language the video actually has. Default: en
TRANSCRIPT_LANGUAGES=

# Transcript cap (characters) handed to the summarizer by /youtube and /podcast.
# Default 480000 (about 120k tokens) fits Gemini's context with room to spare;
# longer transcripts are cut with a truncation note. Whole numbers only. On the
# Grok path this is a real cost (about $0.36 per 3h episode at grok-4 rates),
# so lower it there if that matters.
YOUTUBE_TX_LIMIT=
PODCAST_TX_LIMIT=

# Free Groq-hosted Whisper for /podcast episodes that publish no transcript.
# Get key: https://console.groq.com. Free tier: 7,200 audio-seconds per hour,
# so about one 2h episode per hour; longer ones fall through to OPENAI_API_KEY
# Whisper or show notes. Needs ffmpeg and ffprobe on PATH.
GROQ_API_KEY=

# ─── Model defaults (override if desired) ───────────────────
# xAI endpoint: https://api.x.ai/v1/responses (Agent Tools API)
# grok-4 (non-reasoning) is the right default for /x-read /x-pulse /youtube - these are
# extract-and-format tasks where reasoning is wasted overhead (3-4x more output tokens).
# Switch to grok-4.20-reasoning per-call if you want deeper analysis.
GROK_MODEL=grok-4
PERPLEXITY_RESEARCH_MODEL=sonar-pro
PERPLEXITY_DEEP_MODEL=sonar-deep-research
# Default /notebooklm model. Free tier supports gemini-2.5-flash; gemini-2.5-pro requires paid billing.
NOTEBOOKLM_MODEL=gemini-2.5-flash

# ─── Auto-open behavior ─────────────────────────────────────
# After every research save, Obsidian opens automatically at the note.
# Set to 0 to disable (e.g. when running batch saves or scheduled).
# RESEARCH_AUTOOPEN=0

# ─── Raw chat archive (optional, off by default) ────────────
# When on, /obsidian-save also keeps a redacted copy of the conversation in
# raw/sessions/: what was said, without tool output. A fact the save step
# skipped stays findable after the agent prunes its own transcripts.
# Claude Code only for now.
# OBSIDIAN_SESSION_ARCHIVE=1
